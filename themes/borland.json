          "property": { "color": "#FFFF55" },
          "constructor": { "color": "#FFFF55" },
          "enum": { "color": "#FFFF55" },
          "variant": { "color": "#FFFF55" },
          "label": { "color": "#FFFF55" },
          "lifetime": { "color": "#FFFF55" },
          "namespace": { "color": "#FFFF55" },
          "module": { "color": "#FFFF55" },
          "operator": { "color": "#FFFF55" },
          "punctuation": { "color": "#FFFF55" },
          "embedded": { "color": "#FFFF55" },
          "primary": { "color": "#FFFF55" },

          "title": { "color": "#FFFFFF", "font_weight": 700 },
          "markup.heading": { "color": "#FFFFFF", "font_weight": 700 },
          "emphasis": { "color": "#FFFF55", "font_style": "italic" },
